{
  "name": "nebula-mission-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run build:frontend && node --watch server/dev.ts",
    "start": "node server/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/api.test.ts tests/static.test.ts tests/map-data.test.ts",
    "build:frontend": "node tools/build.mjs",
    "build": "npm run typecheck && npm run build:frontend"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
