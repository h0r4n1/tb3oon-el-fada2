{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/region.ts": { "includeFiles": "data/**" },
    "api/routes.ts": { "includeFiles": "data/**" },
    "api/map-data/*.ts": { "includeFiles": "data/**" }
  }
}
